# Rev4 pin assignments derived from GameBub verilog/handheld/rev_4.xdc.
# Source: https://github.com/elipsitz/gamebub ; retain the original license.
# Only top-level ports used by the non-functional 50-MHz probe are included.
# No Vivado BITSTREAM settings, implicit clock cuts or invented board delays.
set_property PACKAGE_PIN P17 [get_ports {clk_50mhz}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk_50mhz}]
set_property PACKAGE_PIN F5 [get_ports {vibrate_in1}]
set_property IOSTANDARD LVCMOS33 [get_ports {vibrate_in1}]
