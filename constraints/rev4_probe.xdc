create_clock -period 20.000 [get_ports {clk_50mhz}]
# USER4 status port is qualified for a JTAG adapter clock no faster than 10 MHz.
# This clock constraint does NOT establish asynchronous CDC or hold signoff.
create_clock -period 100.000 [get_nets {drck}]
